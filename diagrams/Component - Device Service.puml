@startuml
title WarmHouse Web Application Component Diagram

top to bottom direction

!includeurl https://raw.githubusercontent.com/RicardoNiepel/C4-PlantUML/master/C4_Component.puml

Container_Boundary(WarmHouseSystem, "WarmHouse System") {
  Container(DeviceService, "Device Service", "Manages devices")
  Container(DeviceDB, "Device database", "PostgresQL", "Stores devices")
  Container(TelemetryDB, "Telemetry database", "PostgresQL", "Stores telemetry")
}

Container(DeviceService, "Device Service", "Java, Spring") {
  Component(DeviceController, "DeviceController", "Manages devices")
  Component(KafkaClient, "Kafka Client", "Communicates with Kafka")
  Component(ServiceCore, "Service Core", "Business logic")
  Component(DataLayer, "Data Layer", "Data access logic")
  Component(Driver, "Driver", "Encapsulates device logic")
}

System_Ext(device, "Device")

Rel(DeviceController,ServiceCore,"Calls business logic")
Rel(KafkaClient,ServiceCore,"Calls business logic")
Rel(ServiceCore,DataLayer,"Reads/Writes data")
Rel(ServiceCore,Driver,"Reads/Writes data")
Rel(DataLayer,DeviceDB,"Reads/Writes device data")
Rel(DataLayer, TelemetryDB,"Reads/Writes telemetry data")
Rel(Driver,device,"Controls device")
Rel(device,Driver,"Sends telemetry")
@enduml