@startuml
title WarmHouse Web Application Component Diagram

top to bottom direction

!includeurl https://raw.githubusercontent.com/RicardoNiepel/C4-PlantUML/master/C4_Component.puml

Container_Boundary(WarmHouseSystem, "WarmHouse System") {
  Container(UserService, "User Service", "Manages users")
  Container(Database, "Database", "PostgresQL", "Stores users")
}

Container(UserService, "User Service", "Java, Spring") {
  Component(AuthController, "AuthController", "Manages authentication")
  Component(UserController, "UserController", "Manages users")
  Component(KafkaClient, "Kafka Client", "Communicates with Kafka")
  Component(ServiceCore, "Service Core", "Business logic")
  Component(DataLayer, "Data Layer", "Data access logic")
}

Rel(AuthController,ServiceCore,"Calls business logic")
Rel(UserController,ServiceCore,"Calls business logic")
Rel(KafkaClient,ServiceCore,"Calls business logic")
Rel(ServiceCore,DataLayer,"Reads/Writes data")
Rel(DataLayer,Database,"Reads/Writes heating data")
@enduml