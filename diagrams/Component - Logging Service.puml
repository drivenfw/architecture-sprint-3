@startuml
title WarmHouse Web Application Component Diagram

top to bottom direction

!includeurl https://raw.githubusercontent.com/RicardoNiepel/C4-PlantUML/master/C4_Component.puml

Container_Boundary(WarmHouseSystem, "WarmHouse System") {
  Container(LoggingService, "Logging Service", "Manages logs")
  Container(Database, "Database", "Elasticsearch", "Stores logs")
}

Container(LoggingService, "Logging Service", "Java, Spring") {
  Component(LogController, "LogController", "Manages logs")
  Component(KafkaClient, "Kafka Client", "Communicates with Kafka")
  Component(ServiceCore, "Service Core", "Business logic")
  Component(DataLayer, "Data Layer", "Data access logic")
}

Rel(LogController,ServiceCore,"Calls business logic")
Rel(KafkaClient,ServiceCore,"Calls business logic")
Rel(ServiceCore,DataLayer,"Reads/Writes data")
Rel(DataLayer,Database,"Reads/Writes heating data")
@enduml